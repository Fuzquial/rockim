+        {
+            const int nN = (int)X0_.size();
+#pragma omp parallel for schedule(static)
+            for (int i = 0; i < nN; ++i)
+                for (int t = 0; t < nT; ++t) {
+                    if (!seenTL_[t][i]) continue;
+                    f_[i] += fTL_[t][i];
+                    fTL_[t][i].setZero();
+                    seenTL_[t][i] = 0;
+                }
+        }
         for (int t = 0; t < nT; ++t) {
-            for (int i : touchedTL_[t]) {
-                f_[i] += fTL_[t][i];
-                fTL_[t][i].setZero();
-                seenTL_[t][i] = 0;
-            }
             nEro += eroT[t].law;
             nEroGeo += eroT[t].geo;
             vEroLaw += eroT[t].vLaw;
